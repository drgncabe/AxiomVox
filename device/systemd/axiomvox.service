[Unit]
Description=AxiomVox device appliance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/axiomvox
ExecStart=/opt/axiomvox/.venv/bin/axiomvox-device --host 0.0.0.0 --port 8080 --allow-shutdown --status-file /run/axiomvox/status.json
Restart=on-failure
RestartSec=5
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
